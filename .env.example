# Senha única de acesso (obrigatória). Troque antes de usar.
ADMIN_PASSWORD=troque-esta-senha

# Porta HTTP do servidor.
PORT=3210

# Fuso horário usado nos lembretes ("08:00" significa 08:00 neste fuso).
TZ=America/Sao_Paulo

# Onde fica o banco (Postgres embutido).
DATA_DIR=./data

# Opcional: usar um Postgres externo em vez do embutido.
# DATABASE_URL=postgres://usuario:senha@host:5432/banco

# Opcional: origens que podem chamar a API quando o app é servido de outro endereço.
# ALLOWED_ORIGINS=https://exemplo.github.io

# Contato enviado aos serviços de push (exigência do padrão Web Push): URL https ou mailto.
VAPID_SUBJECT=mailto:voce@exemplo.com

# Use 1 se o Boldo estiver atrás de um proxy reverso que envia X-Forwarded-For.
TRUST_PROXY=0
