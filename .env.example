# Senha única de acesso (obrigatória). Troque antes de usar.
ADMIN_PASSWORD=troque-esta-senha

# Porta HTTP do servidor.
PORT=3210

# Fuso horário usado nos lembretes ("08:00" significa 08:00 neste fuso).
TZ=America/Sao_Paulo

# Onde fica o banco SQLite (boldo.db).
DATA_DIR=./data

# Contato enviado aos serviços de push (exigência do padrão Web Push).
VAPID_SUBJECT=mailto:voce@exemplo.com

# Use 1 se o Boldo estiver atrás de um proxy reverso que envia X-Forwarded-For.
TRUST_PROXY=0
